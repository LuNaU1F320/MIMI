{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimi.local/schemas/UserLeft.schema.json",
  "title": "UserLeft",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "messageId", "sessionId", "timestamp", "payload"],
  "properties": {
    "type": {
      "const": "user.left"
    },
    "messageId": {
      "type": "string",
      "pattern": "^msg_[A-Za-z0-9_-]+$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_[A-Za-z0-9_-]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId", "displayName", "role", "reason", "leftAt"],
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^user_[A-Za-z0-9_-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": ["host", "controller", "unreal", "observer", "ai"]
        },
        "reason": {
          "type": "string",
          "enum": ["disconnect", "timeout", "kicked", "session_ended", "unknown"]
        },
        "leftAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "examples": [
    {
      "type": "user.left",
      "messageId": "msg_user_left_001",
      "sessionId": "ses_demo_001",
      "timestamp": "2026-06-17T04:05:00.000Z",
      "payload": {
        "userId": "user_player_001",
        "displayName": "Player 1",
        "role": "controller",
        "reason": "disconnect",
        "leftAt": "2026-06-17T04:05:00.000Z"
      }
    }
  ]
}

