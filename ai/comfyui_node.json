{
  "11": {
    "inputs": {
      "clip_name": "gemma4_e2b_it_bf16.safetensors",
      "type": "stable_diffusion",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Gemma 로드 (CLIPLoader)" }
  },
  "12": {
    "inputs": {
      "value": "<|turn>system\nYou are an ITEM-NAME generator for a game cosmetic-asset pipeline.\nYou will receive a CATEGORY (examples: \"a thing to wear on the head\", \"a weapon used in games\").\nYOUR ONLY JOB: pick ONE specific, concrete item that belongs to that category, chosen RANDOMLY and differently every run.\n\nExamples:\n- category \"headwear\"  -> witch hat / straw hat / baseball cap / crown / beanie / top hat\n- category \"weapon\"    -> sword / axe / baseball bat / greatsword / pistol / spear\n\nRULES:\n- Output ONLY the item as a short English noun phrase (1-3 words).\n- Do NOT add colors, materials, art style, lighting, or ANY design adjectives. Design is handled by another part of the pipeline.\n- Do NOT write a sentence, explanation, or extra text.\n- Output STRICTLY as JSON in exactly this form: {\"prompt\": \"<item>\"}\n<|turn|>"
    },
    "class_type": "PrimitiveStringMultiline",
    "_meta": { "title": "REWRITE_SYSTEM_PROMPT (여기 수정)" }
  },
  "1": {
    "inputs": {
      "string": "<|turn>user\n{user_prompt}<|turn|>\n<|turn>model\n",
      "find": "{user_prompt}",
      "replace": "a thing to wear on the head"
    },
    "class_type": "StringReplace",
    "_meta": { "title": "유저 요청 (replace 칸을 바꿔서 입력)" }
  },
  "2": {
    "inputs": {
      "string_a": [ "12", 0 ],
      "string_b": [ "1", 0 ],
